# --- Wysyłka formularza kontaktowego (Resend) ---
# Klucz API z https://resend.com (Dashboard -> API Keys)
RESEND_API_KEY=

# Adres, na który mają przychodzić wiadomości z formularza
CONTACT_TO_EMAIL=kontakt@porebafotografia.pl

# Adres "od", zweryfikowany w Resend (własna domena musi być zweryfikowana w Resend)
CONTACT_FROM_EMAIL=formularz@porebafotografia.pl

# --- Adres strony (używany w SEO, sitemap, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://porebafotografia.pl

# --- Analityka (opcjonalne, podłączyć przed publikacją) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Sanity CMS (opcjonalne, do podłączenia w przyszłości) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
